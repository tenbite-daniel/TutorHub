# ==============================================================================
# TutorHub Frontend Environment Variables Template
# Copy this file to .env and fill in the values
# ==============================================================================

# Browser API endpoint path (routed through Next.js rewrites to keep cookies first-party)
NEXT_PUBLIC_BACKEND_URL=/api

# Server-side destination where /api rewrites forward to
# Local dev: http://localhost:5000
# Production on Vercel: https://your-backend-name.onrender.com
BACKEND_ORIGIN=http://localhost:5000
